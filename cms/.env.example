# Local secrets go in .dev.vars (read by the Cloudflare local proxy). This file only lists the names.
# Never put a real secret in this file.
PAYLOAD_SECRET=replace-with-output-of-openssl-rand-hex-32
# Address of the public site. The import button loads the photos from it.
FRONTEND_URL=https://midnight-crew-site.pop-sites.workers.dev
# Used only by the seed script.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-long-password
# Deploy hook URL of the site build. A save in the CMS calls it, and the site is built again. Empty = no rebuild.
REBUILD_WEBHOOK_URL=
# Only for a GitHub repository_dispatch URL. Empty for a Cloudflare deploy hook.
REBUILD_WEBHOOK_TOKEN=
