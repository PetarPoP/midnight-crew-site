{
  "name": "midnight-crew-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-opennext.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack -p 3100",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "build:cf": "opennextjs-cloudflare build -c wrangler.jsonc",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3100",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed.ts",
    "migrate": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:local": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "deploy": "npm run migrate && npm run build:cf && opennextjs-cloudflare deploy -c wrangler.jsonc",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "typecheck": "tsc --noEmit",
    "export-content": "node scripts/export-site-content.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@opennextjs/cloudflare": "1.20.8",
    "@payloadcms/db-d1-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-r2": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "graphql": "^16.8.1",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "~4.116.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "workerd@1.20260930.2": true
  }
}
