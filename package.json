{
  "name": "midnight-crew-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-map-worker.mjs && node scripts/optimize-images.mjs && node scripts/og-images.mjs && vite dev --port 3000",
    "build": "node scripts/fetch-routes.mjs && node scripts/copy-map-worker.mjs && node scripts/optimize-images.mjs && node scripts/og-images.mjs && vite build",
    "preview": "vite preview --port 3000",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "satori": "^0.62.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
